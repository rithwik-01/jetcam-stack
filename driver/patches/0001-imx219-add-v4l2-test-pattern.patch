+static int imx219_set_test_pattern(struct tegracam_device *tc_dev, s32 val)
+{
+	struct camera_common_data *s_data = tc_dev->s_data;
+	int err;
+
+	if (val < 0 || val > IMX219_TEST_PATTERN_MAX)
+		return -EINVAL;
+
+	/* IMX219 test-pattern mode is a big-endian 16-bit register. */
+	err = imx219_write_reg(s_data, IMX219_TEST_PATTERN_ADDR_MSB, 0);
+	if (err)
+		return err;
+
+	return imx219_write_reg(s_data, IMX219_TEST_PATTERN_ADDR_LSB,
+		(u8)val);
 }
 
